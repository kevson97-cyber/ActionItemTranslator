# OpenRouter API key — used for Qwen 3 action item analysis
# Get one at: openrouter.ai (free credits available)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Optional: override the Qwen 3 model (default: qwen/qwen3-30b-a3b)
# Other options: qwen/qwen3-14b, qwen/qwen3-32b, qwen/qwen3-235b-a22b
# QWEN_MODEL=qwen/qwen3-14b

# Optional: override the vision model used for photo capture analysis
# (default: qwen/qwen2.5-vl-72b-instruct)
# VISION_MODEL=qwen/qwen2.5-vl-72b-instruct

# Google OAuth Client ID — required for "Export to Google Tasks"
# Create one at console.cloud.google.com (APIs & Services → Credentials →
# OAuth client ID → Web application, add http://localhost:3002 as an
# authorized JavaScript origin, and enable the Google Tasks API)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Claude conversation URL for the seeded prep curriculum — every curriculum
# card's "Continue in Claude" link points here. Paste your real claude.ai
# conversation URL once you've started the prep thread.
# NEXT_PUBLIC_CLAUDE_THREAD_URL=https://claude.ai/chat/your-conversation-id

# Your deployed app URL (for OpenRouter HTTP-Referer header)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
