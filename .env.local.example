# Groq API key — used for Whisper large-v3 transcription
# Get one free at: console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# OpenRouter API key — used for Qwen 3 analysis
# Get one at: openrouter.ai (free credits available)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Optional: override the Qwen 3 model (default: qwen/qwen3-30b-a3b)
# Other options: qwen/qwen3-14b, qwen/qwen3-32b, qwen/qwen3-235b-a22b
# QWEN_MODEL=qwen/qwen3-14b

# Your deployed app URL (for OpenRouter HTTP-Referer header)
# Set this in Vercel's environment variables dashboard
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
